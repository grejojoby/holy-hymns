# Use your computer's LAN IP for a physical device; Android emulator uses 10.0.2.2.
EXPO_PUBLIC_API_URL=http://localhost:8080/v1
# Public ingestion DSN; errors are disabled in development builds.
EXPO_PUBLIC_SENTRY_DSN=https://86f777d703f79f1db0ddc6c52d97747f@o4507351643389952.ingest.us.sentry.io/4512186331758592
EXPO_PUBLIC_SENTRY_ENVIRONMENT=production
# Optional override; native builds otherwise use app version/build automatically.
EXPO_PUBLIC_SENTRY_RELEASE=
# Source map upload credential belongs in ignored .env.local, NEVER EXPO_PUBLIC_*.
# SENTRY_AUTH_TOKEN=
# Public OAuth client identifiers (never put client secrets in this file).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
GOOGLE_IOS_URL_SCHEME=
# Set unique identifiers before signing native release builds.
IOS_BUNDLE_ID=org.holyhymns.app
ANDROID_PACKAGE=org.holyhymns.app
# Optional local signing team ID (public identifier, not a signing credential).
# IOS_APPLE_TEAM_ID=YOUR_TEAM_ID
# Apple Sign in defaults to enabled; set false for a free Personal Team build.
# IOS_APPLE_SIGN_IN_ENABLED=false
