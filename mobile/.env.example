# Use your computer's LAN IP for a physical device; Android emulator uses 10.0.2.2.
EXPO_PUBLIC_API_URL=http://localhost:8080/v1
# Public OAuth client identifiers (never put client secrets in this file).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
GOOGLE_IOS_URL_SCHEME=
# Set unique identifiers before signing native release builds.
IOS_BUNDLE_ID=org.holyhymns.app
ANDROID_PACKAGE=org.holyhymns.app
