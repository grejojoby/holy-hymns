# Imported by the Oracle VM's existing /etc/caddy/Caddyfile.
holyhymns-backend.grejo.in {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
	# Cloudflare ranges verified 2026-09-19; refresh from both official lists:
	# https://www.cloudflare.com/ips-v4
	# https://www.cloudflare.com/ips-v6
	# Match the connecting peer, never a client-supplied forwarding header.
	@cloudflare {
		remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22
		remote_ip 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	}
	# Caddy flushes text/event-stream responses immediately by default.
	handle @cloudflare {
		reverse_proxy 127.0.0.1:18080 {
			header_up X-Real-IP {http.request.header.CF-Connecting-IP}
		}
	}
	handle {
		reverse_proxy 127.0.0.1:18080 {
			header_up X-Real-IP {remote_host}
		}
	}
}
