# COPY to .env. This password is for LOCAL DEVELOPMENT only; replace before deployment.
# Production: openssl rand -hex 32 (hex is safe in DATABASE_URL).
POSTGRES_PASSWORD=local-development-only-change-before-deployment
HOLY_HYMNS_IMAGE=holy-hymns:local
HOLY_HYMNS_BACKUP_IMAGE=holy-hymns-backup:local
# Empty uses an existing reverse proxy. Set edge for bundled Caddy, or edge,backup
# only after configuring and verifying the backup quota below.
COMPOSE_PROFILES=
PUBLIC_URL=http://localhost:8080
ALLOWED_ORIGIN=http://localhost:8081
API_BIND=127.0.0.1
# Select an unused host port when sharing a VM with other applications.
API_PORT=8080
DOMAIN=localhost
ACME_EMAIL=
PROXY_NETWORK_SUBNET=172.30.41.0/24
CADDY_INTERNAL_IP=172.30.41.10
# Only this trusted proxy can supply client IP for rate limits.
TRUSTED_PROXY_CIDRS=172.30.41.10/32

# Blank SMTP disables delivery; local owner bootstrap does not need email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALLOW_INSECURE_SMTP=false
# Required when mail is configured: openssl rand -base64 32
MAIL_ENCRYPTION_KEY=
MAIL_DAILY_LIMIT=80
MAIL_MONTHLY_LIMIT=2000

# Comma-separated exact production/native client audiences; blank hides sign-in buttons.
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=
# Apple sign-in also needs a signing key to exchange/revoke grants on account deletion.
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Paste the p8 PEM with literal \n between lines; never commit the real key.
APPLE_PRIVATE_KEY=

# Opt-in only; no bucket or paid resources are created by the application.
OCI_FREE_QUOTA_VERIFIED=false
OCI_VERIFIED_FREE_BYTES=0
BACKUP_REMOTE=
BACKUP_AGE_RECIPIENT=
BACKUP_STORAGE_CAP_BYTES=104857600
BACKUP_MAX_ARCHIVE_BYTES=12582912
BACKUP_HOUR_UTC=2
RCLONE_CONFIG_FILE=./deploy/rclone.conf
